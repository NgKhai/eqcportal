@using System.Text.Json

<script>
    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-top-right',
        timeOut: 3000
    };

    @if (TempData["Success"] is string successMessage)
    {
        <text>toastr.success(@Html.Raw(JsonSerializer.Serialize(successMessage)), 'Thành công!');</text>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <text>toastr.error(@Html.Raw(JsonSerializer.Serialize(errorMessage)), 'Lỗi!');</text>
    }
</script>
